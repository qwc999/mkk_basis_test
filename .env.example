# Local development values only. Replace both placeholders before use.
API_KEY=replace-with-a-long-local-api-key
POSTGRES_USER=payments
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=payments
# Inside Compose, PostgreSQL is available at the service name "postgres".
# URL-encode special characters in the password when editing DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://payments:replace-with-a-local-database-password@postgres:5432/payments
API_PORT=8000
